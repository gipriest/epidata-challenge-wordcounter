{
  "name": "epidata-challenge-wordcounter",
  "version": "1.0.0",
  "description": "Framework de pruebas E2E con Playwright + TypeScript para wordcounter.net",
  "scripts": {
    "test": "playwright test --project=api --project=chromium",
    "test:all": "playwright test",
    "test:stable": "playwright test --project=api --project=chromium --grep-invert @defect",
    "test:defects": "playwright test --project=chromium --grep @defect",
    "test:chromium": "playwright test --project=chromium",
    "test:api": "playwright test --project=api",
    "test:headed": "playwright test --project=chromium --headed",
    "test:ui": "playwright test --ui",
    "test:debug": "playwright test --project=chromium --debug",
    "report": "playwright show-report",
    "codegen": "playwright codegen https://wordcounter.net",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/gipriest/epidata-challenge-wordcounter.git"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "commonjs",
  "bugs": {
    "url": "https://github.com/gipriest/epidata-challenge-wordcounter/issues"
  },
  "homepage": "https://github.com/gipriest/epidata-challenge-wordcounter#readme",
  "devDependencies": {
    "@faker-js/faker": "^10.6.0",
    "@playwright/test": "^1.64.1",
    "@types/node": "^26.6.5",
    "dotenv": "^18.0.8",
    "eslint": "^9.39.5",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-playwright": "^2.12.1",
    "prettier": "^3.9.10",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.71.2"
  }
}
